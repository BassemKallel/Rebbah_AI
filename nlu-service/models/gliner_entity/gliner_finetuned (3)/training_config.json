{
  "model_name": "urchade/gliner_multi-v2.1",
  "dataset_path": "gliner_dataset_v3.json",
  "test_size": 0.15,
  "val_size": 0.1,
  "output_dir": "gliner_finetuned",
  "num_train_epochs": 8,
  "learning_rate": 1e-05,
  "others_lr": 3e-05,
  "weight_decay": 0.1,
  "others_weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "lr_scheduler_type": "cosine",
  "max_grad_norm": 10.0,
  "train_batch_size": 8,
  "eval_batch_size": 8,
  "focal_loss_alpha": -1,
  "focal_loss_gamma": 0,
  "save_steps": 200,
  "logging_steps": 20,
  "save_total_limit": 3,
  "labels": [
    "product",
    "color",
    "size",
    "address",
    "brand",
    "client_name",
    "phone_number"
  ],
  "bf16": false
}