{
  "model_name": "urchade/gliner_multi-v2.1",
  "dataset_path": "gliner_dataset_v7.json",
  "test_size": 0.15,
  "val_size": 0.1,
  "output_dir": "../models/gliner_finetuned",
  "num_train_epochs": 5,
  "learning_rate": 1e-05,
  "others_lr": 3e-05,
  "weight_decay": 0.1,
  "others_weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "lr_scheduler_type": "cosine",
  "max_grad_norm": 10.0,
  "train_batch_size": 8,
  "eval_batch_size": 8,
  "gradient_accumulation_steps": 4,
  "focal_loss_alpha": -1,
  "focal_loss_gamma": 0,
  "save_steps": 200,
  "eval_steps": 200,
  "logging_steps": 20,
  "save_total_limit": 10,
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",
  "labels": [
    "address",
    "product",
    "size",
    "quantity",
    "client_name",
    "phone_number",
    "color"
  ],
  "bf16": false
}