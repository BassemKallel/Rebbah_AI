{
  "api": {
    "name": "TikTak Mock API",
    "description": "Cette API a été conçue pour simuler les comportements d'un backend e-commerce multi-tenant (type Shopify) où chaque boutique (Store) possède son propre catalogue de produits.",
    "authentication": {
      "type": "custom_header",
      "description": "Cloisonnement strict par entête HTTP (Header) pour simuler l'approche Multi-Tenant.",
      "required_header": {
        "key": "X-Store-ID",
        "value": "UUID de la boutique ciblée",
        "missing_behavior": "400 Bad Request",
        "invalid_behavior": "404 Not Found"
      }
    },
    "endpoints": [
      {
        "name": "Lister les Produits",
        "description": "Récupère l'intégralité du catalogue actif d'une boutique donnée. Les produits 'parents' sont retournés avec leurs variations imbriquées.",
        "url": "/api/v1/products/",
        "method": "GET",
        "headers": {
          "X-Store-ID": "<UUID_DE_LA_BOUTIQUE>"
        },
        "responses": {
          "200": {
            "description": "Succès - Liste des produits et de leurs déclinaisons",
            "body": [
              {
                "id": "e9cdb583-94c5-4d5d-ba06-9cb9624da91f",
                "store_id": 47,
                "name": "Pull",
                "base_price": "79.990",
                "is_active": true,
                "variations": [
                  {
                    "id": "e9a7e6c0-78a0-42d6-bccc-98ff2a0b12bc",
                    "color": "Bleu Ciel",
                    "size": "M",
                    "image": "https://tiktakshopstorage.blob.core.windows.net/media/variations/pull_bleu_ciel.webp",
                    "stock_quantity": 12,
                    "price_override": null
                  },
                  {
                    "id": "fbcab721-8201-447a-bd9e-21eaab988bcd",
                    "color": "Noir",
                    "size": "M",
                    "image": "https://tiktakshopstorage.blob.core.windows.net/media/variations/pull_noir.webp",
                    "stock_quantity": 5,
                    "price_override": null
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "name": "Détail d'un Produit",
        "description": "Récupère les détails spécifiques d'un seul produit père (et de ses déclinaisons) en se basant sur son UUID.",
        "url": "/api/v1/products/<uuid:pk>/",
        "method": "GET",
        "headers": {
          "X-Store-ID": "<UUID_DE_LA_BOUTIQUE>"
        },
        "url_parameters": {
          "pk": "UUID du produit"
        },
        "responses": {
          "200": {
            "description": "Succès - Détail du produit",
            "body": {
              "id": "e9cdb583-94c5-4d5d-ba06-9cb9624da91f",
              "store_id": 47,
              "name": "Pull",
              "base_price": "79.990",
              "is_active": true,
              "variations": []
            }
          },
          "400": {
            "description": "Bad Request",
            "body": {
              "detail": "Missing X-Store-ID header."
            }
          },
          "404": {
            "description": "Not Found",
            "body": {
              "detail": "Pas trouvé."
            }
          }
        }
      }
    ]
  },
  "models": {
    "Store": {
      "fields": {
        "id": { "type": "UUID", "description": "Identifiant unique mondial." },
        "name": { "type": "String", "description": "Nom de la boutique (ex: 'Asses Boutique')." },
        "domain": { "type": "String", "description": "Domaine web, doit être unique (ex: 'asses.tiktak.tn')." }
      }
    },
    "Product": {
      "fields": {
        "id": { "type": "UUID", "description": "Identifiant unique du produit." },
        "store_id": { "type": "FK (UUID)", "description": "Clé étrangère liant le produit à son Store propriétaire." },
        "name": { "type": "String", "description": "Libellé général du produit (ex: 'Veste')." },
        "base_price": { "type": "Decimal", "description": "Prix de base par défaut du produit (3 décimales)." },
        "is_active": { "type": "Boolean", "description": "True si le produit est affichable côté client/API." }
      }
    },
    "ProductVariation": {
      "fields": {
        "id": { "type": "UUID", "description": "Identifiant unique de la déclinaison." },
        "product_id": { "type": "FK (UUID)", "description": "Clé étrangère pointant vers le Produit 'Parent'." },
        "color": { "type": "String", "description": "Texte identifiant visuellement la déclinaison (ex: 'Bleu Ciel')." },
        "size": { "type": "String", "description": "Taille (ex: 'S', 'M', 'L')." },
        "image": { "type": "Azure URL", "description": "Lien absolu redirigeant vers l'image dans le cloud Azure Blob Storage." },
        "stock_quantity": { "type": "Integer", "description": "Quantité restante dans l'inventaire pour ce duo taille/couleur." },
        "price_override": { "type": "Decimal (Null)", "description": "Peut remplacer le prix parent si cette variation est plus chère." }
      }
    }
  }
}
