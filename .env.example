# ======= Database (PostgreSQL — main) =======
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=rebbah

# ======= Django =======
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost
# Origines autorisées pour le dashboard et les POST (séparées par des virgules), ex: https://your-domain.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ======= Vector Database (pgvector) =======
VECTOR_DB_HOST=db
VECTOR_DB_USER=
VECTOR_DB_PASSWORD=
VECTOR_DB_NAME=rebbah_vectors
VECTOR_DB_PORT=5432

DJANGO_SECRET_KEY=change-me-in-production


# Vision Service
VISION_SERVICE_URL=http://vision-service:8002
VISION_SEARCH_PATH=/search-similar
SIMILARITY_THRESHOLD=0.75


# Request timeout (seconds)
EXTERNAL_REQUEST_TIMEOUT=15

# ======= Azure Blob Storage =======
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media

# ======= Gemini LLM =======
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ======= Meta Webhook =======
META_VERIFY_TOKEN=
META_APP_SECRET=

# ======= Initial Setup (auto-created on first deploy) =======
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@rebbah.ai
DJANGO_SUPERUSER_PASSWORD=
SHOP_ID=
SHOP_NAME=Rebbah Shop

# ======= Encryption (API keys at rest) =======
FIELD_ENCRYPTION_KEY=

# ======= Local development tunnel (optional) =======
# NGROK_URL=https://xxxx.ngrok-free.app
