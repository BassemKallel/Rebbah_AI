# ======= Database (PostgreSQL — main) =======
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=tiktak

# ======= Django =======
DJANGO_DEBUG=False
ALLOWED_HOSTS=ai.tiktakpro.com,localhost

# ======= Vector Database (pgvector) =======
VECTOR_DB_HOST=db
VECTOR_DB_USER=
VECTOR_DB_PASSWORD=
VECTOR_DB_NAME=tiktak_vectors
VECTOR_DB_PORT=5432

DJANGO_SECRET_KEY=change-me-in-production


# Vision Service
VISION_SERVICE_URL=http://vision-service:8002
VISION_SEARCH_PATH=/search-similar

# TikTak Real API
TIKTAK_API_BASE_URL=https://api.tiktakpro.com
TIKTAK_API_PRODUCTS_PATH=/api/v1/products-read/

# Request timeout (seconds)
EXTERNAL_REQUEST_TIMEOUT=15

# ======= Azure Blob Storage =======
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media

# ======= Gemini LLM =======
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ======= Meta Webhook =======
META_VERIFY_TOKEN=

# ======= Initial Setup (auto-created on first deploy) =======
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@tiktakpro.com
DJANGO_SUPERUSER_PASSWORD=
SHOP_ID=
SHOP_NAME=TikTak Shop

# ======= Encryption (API keys at rest) =======
FIELD_ENCRYPTION_KEY=
