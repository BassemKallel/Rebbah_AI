# ============================================================
# TikTak-AI — Environment Variables Template
# Copier ce fichier en .env et adapter les valeurs
# IMPORTANT: Ne jamais committer .env (contient des secrets)
# ============================================================

# ======= PostgreSQL (base principale) =======
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tiktak

# ======= VectorDB (pgvector) =======
VECTOR_DB_USER=tiktak_vector
VECTOR_DB_PASSWORD=changeme
VECTOR_DB_NAME=tiktak_vectors
VECTOR_DB_PORT=5433

# ======= External Services =======
# NLU Service (TunBERT + GLiNER) — URLs internes Docker par défaut
NLU_SERVICE_URL=http://nlu-service:8001
NLU_PREDICT_PATH=/predict

# Vision Service (CLIP) — URLs internes Docker par défaut
VISION_SERVICE_URL=http://vision-service:8002
VISION_SEARCH_PATH=/search-similar

# TikTak Real API — catalogue produits
TIKTAK_API_BASE_URL=https://api.tiktakpro.com
TIKTAK_API_PRODUCTS_PATH=/api/v1/products-read/
PRODUCTS_CACHE_TTL=600

# Timeout des requêtes HTTP sortantes (secondes)
EXTERNAL_REQUEST_TIMEOUT=5
